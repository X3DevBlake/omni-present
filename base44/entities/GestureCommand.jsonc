{
  "name": "GestureCommand",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "description": "Unique gesture command identifier"
    },
    "user_id": {
      "type": "string",
      "description": "User who performed the gesture"
    },
    "gesture_type": {
      "type": "string",
      "enum": [
        "swipe_left",
        "swipe_right",
        "swipe_up",
        "swipe_down",
        "pinch",
        "expand",
        "rotate",
        "tap",
        "double_tap",
        "long_press",
        "circle",
        "wave"
      ],
      "description": "Type of gesture performed"
    },
    "gesture_data": {
      "type": "object",
      "properties": {
        "start_point": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "end_point": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "velocity": {
          "type": "number"
        },
        "pressure": {
          "type": "number"
        },
        "duration_ms": {
          "type": "number"
        }
      }
    },
    "spatial_context": {
      "type": "object",
      "properties": {
        "environment_id": {
          "type": "string"
        },
        "target_object_id": {
          "type": "string"
        },
        "nearby_objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interpreted_intent": {
      "type": "string",
      "description": "AI-interpreted user intention"
    },
    "executed_action": {
      "type": "string",
      "description": "Action that was triggered"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "command_id",
    "user_id",
    "gesture_type"
  ]
}