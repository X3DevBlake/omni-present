{
  "name": "SimulationEnvironmentConfig",
  "type": "object",
  "properties": {
    "environment_name": {
      "type": "string",
      "description": "Simulation environment name"
    },
    "environment_type": {
      "type": "string",
      "enum": [
        "economic",
        "social",
        "competitive",
        "cooperative",
        "mixed"
      ],
      "description": "Type of simulation"
    },
    "physics_enabled": {
      "type": "boolean",
      "default": true
    },
    "gravity": {
      "type": "number",
      "default": -9.8
    },
    "terrain_config": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "flat",
            "hilly",
            "mountainous",
            "urban",
            "procedural"
          ]
        },
        "size": {
          "type": "number"
        },
        "seed": {
          "type": "string"
        }
      }
    },
    "weather_system": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "current_weather": {
          "type": "string"
        }
      }
    },
    "resource_distribution": {
      "type": "object",
      "description": "How resources spawn in environment"
    },
    "max_agents": {
      "type": "integer",
      "default": 100
    },
    "time_scale": {
      "type": "number",
      "default": 1.0,
      "description": "Simulation speed multiplier"
    },
    "event_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string"
          },
          "trigger_condition": {
            "type": "string"
          },
          "frequency": {
            "type": "number"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "environment_name",
    "environment_type"
  ]
}