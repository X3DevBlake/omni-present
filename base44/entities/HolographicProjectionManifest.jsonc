{
  "name": "HolographicProjectionManifest",
  "type": "object",
  "properties": {
    "manifest_id": {
      "type": "string",
      "description": "Unique projection manifest identifier"
    },
    "neural_stream_id": {
      "type": "string",
      "description": "Source neural signal stream"
    },
    "projection_type": {
      "type": "string",
      "enum": [
        "POT_volumetric",
        "light_field",
        "holographic_interference",
        "aether_display"
      ],
      "description": "Type of volumetric display"
    },
    "particle_physics": {
      "type": "object",
      "properties": {
        "particle_type": {
          "type": "string",
          "enum": [
            "cellulose",
            "diamond_dust",
            "graphene_oxide"
          ]
        },
        "particle_radius_um": {
          "type": "number"
        },
        "photophoretic_force_pN": {
          "type": "number"
        },
        "laser_intensity_W_mm2": {
          "type": "number"
        },
        "scanning_velocity_m_s": {
          "type": "number"
        },
        "asymmetry_factor_J1": {
          "type": "number"
        },
        "temperature_gradient_K": {
          "type": "number"
        },
        "vaporization_risk": {
          "type": "number"
        }
      }
    },
    "spatial_configuration": {
      "type": "object",
      "properties": {
        "trap_positions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          }
        },
        "beam_type": {
          "type": "string",
          "enum": [
            "vortex",
            "bottle",
            "laguerre_gaussian"
          ]
        },
        "focal_depth_m": {
          "type": "number"
        }
      }
    },
    "slm_configuration": {
      "type": "object",
      "properties": {
        "phase_pattern": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "refresh_rate_hz": {
          "type": "number"
        }
      }
    },
    "volume_bounds": {
      "type": "object",
      "properties": {
        "x_min": {
          "type": "number"
        },
        "x_max": {
          "type": "number"
        },
        "y_min": {
          "type": "number"
        },
        "y_max": {
          "type": "number"
        },
        "z_min": {
          "type": "number"
        },
        "z_max": {
          "type": "number"
        }
      }
    },
    "flicker_fusion_threshold_hz": {
      "type": "number",
      "default": 10
    },
    "thermodynamic_stability_score": {
      "type": "number"
    },
    "content_descriptor": {
      "type": "string",
      "description": "What is being displayed"
    },
    "swarm_control_agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "manifest_id",
    "projection_type"
  ]
}