{
  "name": "TrainingCurriculum",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Agent being trained"
    },
    "skill_gaps_identified": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills needing improvement"
    },
    "learning_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_name": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "estimated_duration": {
            "type": "number"
          }
        }
      }
    },
    "adaptive_path": {
      "type": "object",
      "description": "Dynamic learning adjustments"
    },
    "current_difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "beginner"
    },
    "completion_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    }
  },
  "required": [
    "agent_id",
    "skill_gaps_identified"
  ]
}