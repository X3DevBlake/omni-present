{
  "name": "OmniBankAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Account owner email"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "investment",
        "crypto"
      ],
      "description": "Type of account"
    },
    "account_number": {
      "type": "string",
      "description": "Account number"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current balance"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Account currency"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "closed"
      ],
      "default": "active",
      "description": "Account status"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate %"
    },
    "monthly_fee": {
      "type": "number",
      "default": 0,
      "description": "Monthly maintenance fee"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Account features enabled"
    }
  },
  "required": [
    "user_email",
    "account_type",
    "account_number"
  ]
}