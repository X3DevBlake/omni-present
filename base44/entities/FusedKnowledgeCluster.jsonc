{
  "name": "FusedKnowledgeCluster",
  "type": "object",
  "properties": {
    "cluster_id": {
      "type": "string",
      "description": "Unique cluster identifier"
    },
    "cluster_name": {
      "type": "string",
      "description": "AI-generated cluster name"
    },
    "source_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DecentralizedKnowledgeNode IDs that were fused"
    },
    "fused_content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "ai_summary": {
          "type": "string"
        },
        "key_insights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synthesized_data": {
          "type": "object"
        }
      }
    },
    "source_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "simulation_result",
          "ethical_audit",
          "external_feed",
          "user_contribution",
          "agent_learning"
        ]
      }
    },
    "fusion_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence in fusion quality"
    },
    "emergent_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "insight": {
            "type": "string"
          },
          "novelty_score": {
            "type": "number"
          },
          "relevance_score": {
            "type": "number"
          },
          "supporting_nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "semantic_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "related_cluster_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "strength": {
            "type": "number"
          }
        }
      }
    },
    "nlp_embeddings": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vector embeddings for semantic search"
    },
    "query_hits": {
      "type": "integer",
      "default": 0,
      "description": "Number of times accessed via queries"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "cluster_id",
    "cluster_name",
    "source_nodes"
  ]
}