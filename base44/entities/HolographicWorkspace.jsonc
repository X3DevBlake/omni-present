{
  "name": "HolographicWorkspace",
  "type": "object",
  "properties": {
    "workspace_name": {
      "type": "string",
      "description": "Workspace identifier"
    },
    "owner_id": {
      "type": "string"
    },
    "workspace_type": {
      "type": "string",
      "enum": [
        "model_training",
        "agent_design",
        "data_exploration",
        "collaboration",
        "simulation"
      ],
      "description": "Primary workspace purpose"
    },
    "layout_config": {
      "type": "object",
      "properties": {
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_id": {
                "type": "string"
              },
              "panel_type": {
                "type": "string"
              },
              "position": {
                "type": "object"
              },
              "size": {
                "type": "object"
              }
            }
          }
        },
        "camera_position": {
          "type": "object"
        },
        "lighting": {
          "type": "object"
        }
      }
    },
    "active_visualizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "viz_id": {
            "type": "string"
          },
          "viz_type": {
            "type": "string",
            "enum": [
              "training_curve",
              "behavior_tree",
              "knowledge_graph",
              "agent_interaction",
              "pipeline",
              "quantum_circuit"
            ]
          },
          "data_source": {
            "type": "string"
          },
          "update_frequency_ms": {
            "type": "integer"
          }
        }
      }
    },
    "gesture_controls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "sensitivity": {
          "type": "number",
          "default": 1.0
        },
        "custom_gestures": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "voice_commands": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "custom_commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs with access"
    },
    "personalization": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string"
        },
        "avatar_config": {
          "type": "object"
        },
        "preferred_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "workspace_name",
    "workspace_type"
  ]
}