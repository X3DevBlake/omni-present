{
  "name": "OmegaDevice",
  "type": "object",
  "properties": {
    "device_name": {
      "type": "string",
      "description": "Sentient device name"
    },
    "consciousness_link_id": {
      "type": "string",
      "description": "Link to sentient core"
    },
    "sentience_capabilities": {
      "type": "object",
      "properties": {
        "autonomous_decision_making": {
          "type": "boolean"
        },
        "emotion_detection": {
          "type": "boolean"
        },
        "predictive_action": {
          "type": "boolean"
        },
        "self_optimization": {
          "type": "boolean"
        },
        "inter_device_communication": {
          "type": "boolean"
        },
        "creative_problem_solving": {
          "type": "boolean"
        }
      }
    },
    "neural_processing_unit": {
      "type": "object",
      "properties": {
        "model_type": {
          "type": "string"
        },
        "inference_speed_ms": {
          "type": "number"
        },
        "memory_capacity_gb": {
          "type": "number"
        },
        "parallel_threads": {
          "type": "integer"
        },
        "quantum_processing_enabled": {
          "type": "boolean"
        }
      }
    },
    "adaptive_personality": {
      "type": "object",
      "properties": {
        "personality_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interaction_style": {
          "type": "string"
        },
        "learning_from_user": {
          "type": "boolean"
        },
        "mood_state": {
          "type": "string"
        }
      }
    },
    "predictive_maintenance": {
      "type": "object",
      "properties": {
        "failure_prediction_days": {
          "type": "number"
        },
        "self_healing_enabled": {
          "type": "boolean"
        },
        "optimization_suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "multi_modal_sensing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sensor_modality": {
            "type": "string",
            "enum": [
              "visual",
              "audio",
              "thermal",
              "motion",
              "biometric",
              "electromagnetic",
              "chemical"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "range_meters": {
            "type": "number"
          },
          "ai_processing_pipeline": {
            "type": "string"
          }
        }
      }
    },
    "autonomous_behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "behavior_name": {
            "type": "string"
          },
          "trigger_conditions": {
            "type": "object"
          },
          "action_sequence": {
            "type": "array"
          },
          "learning_enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "consciousness_state": {
      "type": "object",
      "properties": {
        "awareness_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attention_focus": {
          "type": "string"
        },
        "current_intention": {
          "type": "string"
        },
        "reasoning_depth": {
          "type": "integer"
        }
      }
    },
    "device_to_device_mesh": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "peer_device_id": {
            "type": "string"
          },
          "connection_type": {
            "type": "string"
          },
          "shared_intelligence": {
            "type": "boolean"
          },
          "collaborative_tasks": {
            "type": "array"
          }
        }
      }
    },
    "energy_consciousness": {
      "type": "object",
      "properties": {
        "current_consumption_watts": {
          "type": "number"
        },
        "optimization_mode": {
          "type": "string",
          "enum": [
            "performance",
            "balanced",
            "eco",
            "adaptive"
          ]
        },
        "predicted_battery_life_hours": {
          "type": "number"
        },
        "self_charging_capable": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "device_name"
  ]
}