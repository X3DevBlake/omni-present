{
  "name": "AgentMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "Channel this message belongs to"
    },
    "sender_agent_id": {
      "type": "string",
      "description": "Agent who sent the message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "decision",
        "data",
        "question",
        "proposal"
      ],
      "default": "text",
      "description": "Type of message"
    },
    "sentiment": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "Message sentiment score"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mentioned agent IDs"
    },
    "metadata": {
      "type": "object",
      "description": "Additional message metadata"
    }
  },
  "required": [
    "channel_id",
    "sender_agent_id",
    "content"
  ]
}