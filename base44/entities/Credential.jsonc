{
  "name": "Credential",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who owns credential"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "email_verified",
        "phone_verified",
        "id_verified",
        "credit_score",
        "employment",
        "education",
        "custom"
      ],
      "description": "Type of credential"
    },
    "issuer": {
      "type": "string",
      "description": "Who issued the credential"
    },
    "credential_data": {
      "type": "object",
      "description": "Credential data (varies by type)"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Is credential verified"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When credential was issued"
    },
    "expiration_date": {
      "type": "string",
      "format": "date-time",
      "description": "When credential expires"
    },
    "proof": {
      "type": "string",
      "description": "Cryptographic proof"
    }
  },
  "required": [
    "user_email",
    "credential_type",
    "issuer"
  ]
}