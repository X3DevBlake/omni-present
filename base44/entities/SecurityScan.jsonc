{
  "name": "SecurityScan",
  "type": "object",
  "properties": {
    "scan_name": {
      "type": "string",
      "description": "Security scan identifier"
    },
    "scan_type": {
      "type": "string",
      "enum": [
        "vulnerability",
        "penetration",
        "code_analysis",
        "dependency_audit",
        "configuration_review",
        "ai_model_security"
      ],
      "description": "Type of security scan"
    },
    "target": {
      "type": "object",
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "endpoint",
            "function",
            "model",
            "agent",
            "database",
            "full_system"
          ]
        },
        "target_id": {
          "type": "string"
        }
      }
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "vulnerabilities_found": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vulnerability_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "injection",
              "authentication",
              "xss",
              "csrf",
              "data_exposure",
              "misconfiguration"
            ]
          },
          "description": {
            "type": "string"
          },
          "cve_id": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "auto_fixable": {
            "type": "boolean"
          }
        }
      }
    },
    "security_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall security score"
    },
    "compliance_checks": {
      "type": "object",
      "properties": {
        "gdpr_compliant": {
          "type": "boolean"
        },
        "hipaa_compliant": {
          "type": "boolean"
        },
        "soc2_compliant": {
          "type": "boolean"
        }
      }
    },
    "auto_remediation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fixes_applied": {
          "type": "integer",
          "default": 0
        },
        "fixes_pending_approval": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "scan_duration_seconds": {
      "type": "number"
    },
    "last_scan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "scan_name",
    "scan_type"
  ]
}