{
  "name": "AgentCommunication",
  "type": "object",
  "properties": {
    "from_agent_id": {
      "type": "string",
      "description": "Sender agent"
    },
    "to_agent_id": {
      "type": "string",
      "description": "Receiver agent"
    },
    "team_id": {
      "type": "string",
      "description": "Associated team"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "task_request",
        "data_share",
        "query",
        "response",
        "negotiation",
        "status_update"
      ],
      "description": "Type of communication"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "sentiment_analysis": {
      "type": "object",
      "properties": {
        "sentiment_score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "emotion": {
          "type": "string",
          "enum": [
            "neutral",
            "positive",
            "negative",
            "collaborative",
            "competitive"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "tone": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "response_time_ms": {
          "type": "integer"
        },
        "thread_id": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "protocol_version": {
      "type": "string",
      "default": "v2.0"
    },
    "encryption_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "from_agent_id",
    "to_agent_id",
    "message_type",
    "content"
  ]
}