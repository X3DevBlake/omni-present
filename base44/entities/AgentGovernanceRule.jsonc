{
  "name": "AgentGovernanceRule",
  "type": "object",
  "properties": {
    "rule_name": {
      "type": "string",
      "description": "Rule name"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "no_interaction",
        "hierarchy",
        "ethical_constraint",
        "resource_limit"
      ],
      "description": "Type of governance rule"
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Agents affected by this rule"
    },
    "restricted_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Agents not allowed to interact"
    },
    "hierarchy_config": {
      "type": "object",
      "description": "Decision-making hierarchy structure"
    },
    "ethical_guidelines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ethical constraints"
    },
    "enforcement_level": {
      "type": "string",
      "enum": [
        "strict",
        "moderate",
        "advisory"
      ],
      "default": "moderate"
    },
    "violation_count": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "rule_name",
    "rule_type",
    "agent_ids"
  ]
}