{
  "name": "SentientVisualization",
  "type": "object",
  "properties": {
    "visualization_id": {
      "type": "string",
      "description": "Unique visualization identifier"
    },
    "hub_context": {
      "type": "string",
      "description": "Which hub/page this visualization serves"
    },
    "adaptive_rendering": {
      "type": "object",
      "properties": {
        "user_attention_tracking": {
          "type": "boolean"
        },
        "complexity_auto_adjustment": {
          "type": "boolean"
        },
        "performance_adaptive": {
          "type": "boolean"
        },
        "emotional_color_mapping": {
          "type": "boolean"
        }
      }
    },
    "interaction_intelligence": {
      "type": "object",
      "properties": {
        "gesture_prediction": {
          "type": "number"
        },
        "intent_recognition": {
          "type": "number"
        },
        "context_awareness": {
          "type": "number"
        },
        "proactive_suggestions": {
          "type": "array"
        }
      }
    },
    "neural_feedback_loop": {
      "type": "object",
      "properties": {
        "user_preference_learning": {
          "type": "boolean"
        },
        "layout_optimization": {
          "type": "boolean"
        },
        "color_scheme_adaptation": {
          "type": "boolean"
        },
        "interaction_pattern_memory": {
          "type": "array"
        }
      }
    },
    "immersive_dimensions": {
      "type": "object",
      "properties": {
        "depth_layers": {
          "type": "integer"
        },
        "haptic_feedback_enabled": {
          "type": "boolean"
        },
        "spatial_audio": {
          "type": "boolean"
        },
        "environmental_response": {
          "type": "boolean"
        }
      }
    },
    "data_storytelling": {
      "type": "object",
      "properties": {
        "narrative_generation": {
          "type": "boolean"
        },
        "insight_highlighting": {
          "type": "array"
        },
        "causality_visualization": {
          "type": "boolean"
        }
      }
    },
    "real_time_evolution": {
      "type": "object",
      "properties": {
        "auto_layout_adjustment": {
          "type": "boolean"
        },
        "dynamic_detail_level": {
          "type": "string"
        },
        "predictive_rendering": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "visualization_id",
    "hub_context"
  ]
}