{
  "name": "DiffusionModel",
  "type": "object",
  "properties": {
    "model_name": {
      "type": "string",
      "description": "Diffusion model identifier"
    },
    "diffusion_type": {
      "type": "string",
      "enum": [
        "DDPM",
        "DDIM",
        "LatentDiffusion",
        "ScoreBased"
      ],
      "description": "Diffusion algorithm"
    },
    "noise_schedule": {
      "type": "string",
      "enum": [
        "linear",
        "cosine",
        "quadratic"
      ],
      "description": "Forward process schedule"
    },
    "timesteps": {
      "type": "integer",
      "description": "Number of diffusion steps"
    },
    "sampling_steps": {
      "type": "integer",
      "description": "Inference denoising steps"
    },
    "guidance_scale": {
      "type": "number",
      "description": "Classifier-free guidance strength"
    },
    "generation_quality": {
      "type": "object",
      "properties": {
        "fid_score": {
          "type": "number"
        },
        "inception_score": {
          "type": "number"
        },
        "lpips_diversity": {
          "type": "number"
        }
      }
    },
    "latent_space_dim": {
      "type": "integer"
    },
    "conditioning_type": {
      "type": "string",
      "enum": [
        "text",
        "class",
        "image",
        "multimodal"
      ]
    }
  },
  "required": [
    "model_name",
    "diffusion_type"
  ]
}