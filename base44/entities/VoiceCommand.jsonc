{
  "name": "VoiceCommand",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "description": "Unique voice command identifier"
    },
    "user_id": {
      "type": "string",
      "description": "User who spoke the command"
    },
    "audio_transcript": {
      "type": "string",
      "description": "Transcribed speech"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to audio recording"
    },
    "language_detected": {
      "type": "string",
      "description": "Language code (e.g., en-US)"
    },
    "intent": {
      "type": "string",
      "description": "Extracted user intent"
    },
    "entities_extracted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "spatial_context": {
      "type": "object",
      "properties": {
        "environment_id": {
          "type": "string"
        },
        "user_location": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "looking_at_object_id": {
          "type": "string"
        }
      }
    },
    "executed_action": {
      "type": "object",
      "properties": {
        "action_type": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "result": {
          "type": "string"
        }
      }
    },
    "response_text": {
      "type": "string",
      "description": "AI assistant's response"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "command_id",
    "user_id",
    "audio_transcript"
  ]
}