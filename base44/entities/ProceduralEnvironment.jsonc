{
  "name": "ProceduralEnvironment",
  "type": "object",
  "properties": {
    "environment_name": {
      "type": "string",
      "description": "AI-generated environment name"
    },
    "generation_seed": {
      "type": "string",
      "description": "Seed for reproducibility"
    },
    "complexity_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Environment complexity"
    },
    "terrain_config": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "urban",
            "natural",
            "abstract",
            "mixed"
          ]
        },
        "size_km": {
          "type": "number"
        },
        "elevation_variance": {
          "type": "number"
        },
        "density": {
          "type": "number"
        }
      },
      "description": "Terrain generation parameters"
    },
    "dynamic_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element_type": {
            "type": "string"
          },
          "behavior_rules": {
            "type": "object"
          },
          "spawn_rate": {
            "type": "number"
          }
        }
      },
      "description": "Dynamic environment elements"
    },
    "resource_distribution": {
      "type": "object",
      "description": "How resources are distributed"
    },
    "ai_generated_rules": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Rules generated by AI"
    },
    "visualization_ready": {
      "type": "boolean",
      "default": false,
      "description": "Whether 3D assets generated"
    },
    "agent_capacity": {
      "type": "integer",
      "description": "Max agents supported"
    }
  },
  "required": [
    "environment_name",
    "complexity_level"
  ]
}