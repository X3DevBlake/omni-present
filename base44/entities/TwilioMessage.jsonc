{
  "name": "TwilioMessage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent that sent the message"
    },
    "to_number": {
      "type": "string",
      "description": "Recipient phone number"
    },
    "from_number": {
      "type": "string",
      "description": "Twilio from number"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "twilio_sid": {
      "type": "string",
      "description": "Twilio message SID"
    },
    "autonomous": {
      "type": "boolean",
      "default": false,
      "description": "Sent autonomously by agent"
    },
    "triggered_by": {
      "type": "string",
      "description": "Event that triggered autonomous message"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Message generated by AI"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Message status"
    }
  },
  "required": [
    "user_email",
    "to_number",
    "message"
  ]
}