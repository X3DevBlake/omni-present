{
  "name": "VerifiableCredential",
  "type": "object",
  "properties": {
    "credential_id": {
      "type": "string"
    },
    "issuer_did": {
      "type": "string"
    },
    "subject_did": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "SkillAttestation",
        "ContributionProof",
        "ReputationBadge",
        "IdentityVerification"
      ]
    },
    "claims": {
      "type": "object"
    },
    "issuance_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiration_date": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "issuer_did",
    "subject_did",
    "type",
    "claims"
  ]
}