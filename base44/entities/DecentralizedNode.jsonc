{
  "name": "DecentralizedNode",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique node identifier"
    },
    "node_address": {
      "type": "string",
      "description": "Blockchain address"
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Agents on this node"
    },
    "platform": {
      "type": "string",
      "description": "Platform/instance identifier"
    },
    "public_key": {
      "type": "string",
      "description": "Public key for encryption"
    },
    "reputation_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Node reputation"
    },
    "discovery_status": {
      "type": "string",
      "enum": [
        "discoverable",
        "private",
        "invite_only"
      ],
      "default": "discoverable"
    },
    "connected_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Connected node IDs"
    },
    "collaboration_count": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "node_id",
    "node_address",
    "platform"
  ]
}