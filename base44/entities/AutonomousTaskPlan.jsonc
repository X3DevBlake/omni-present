{
  "name": "AutonomousTaskPlan",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique plan identifier"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent creating the plan"
    },
    "high_level_goal": {
      "type": "string",
      "description": "The original high-level goal"
    },
    "goal_category": {
      "type": "string",
      "enum": [
        "household",
        "entertainment",
        "work",
        "health",
        "security",
        "social",
        "maintenance"
      ]
    },
    "sub_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "execution_order": {
            "type": "integer"
          },
          "estimated_duration_minutes": {
            "type": "number"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assigned_to": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "agent",
                  "device",
                  "user"
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed",
              "blocked"
            ]
          },
          "progress_percentage": {
            "type": "number"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "execution_strategy": {
      "type": "object",
      "properties": {
        "parallel_execution": {
          "type": "boolean"
        },
        "critical_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optimization_priority": {
          "type": "string",
          "enum": [
            "speed",
            "energy",
            "quality",
            "cost"
          ]
        },
        "fallback_strategies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "context_requirements": {
      "type": "object",
      "properties": {
        "required_devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environmental_conditions": {
          "type": "object"
        },
        "time_constraints": {
          "type": "object",
          "properties": {
            "start_by": {
              "type": "string",
              "format": "date-time"
            },
            "complete_by": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "planning",
        "ready",
        "executing",
        "paused",
        "completed",
        "failed"
      ],
      "default": "planning"
    },
    "overall_progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "high_level_goal",
    "agent_id"
  ]
}