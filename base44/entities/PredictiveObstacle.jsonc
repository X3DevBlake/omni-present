{
  "name": "PredictiveObstacle",
  "type": "object",
  "properties": {
    "obstacle_id": {
      "type": "string",
      "description": "Unique obstacle identifier"
    },
    "environment_id": {
      "type": "string",
      "description": "Reference to spatial environment"
    },
    "current_position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "predicted_trajectory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "uncertainty_radius": {
            "type": "number"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "impact_score": {
      "type": "number",
      "description": "Severity if collision occurs"
    },
    "affected_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Agents potentially impacted"
    },
    "avoidance_strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy_name": {
            "type": "string"
          },
          "alternative_path": {
            "type": "array"
          },
          "cost_estimate": {
            "type": "number"
          }
        }
      }
    },
    "prediction_model_used": {
      "type": "string",
      "description": "AI model that generated prediction"
    }
  },
  "required": [
    "obstacle_id",
    "current_position",
    "predicted_trajectory"
  ]
}