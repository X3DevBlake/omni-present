{
  "name": "CompanionEmotionalBond",
  "type": "object",
  "properties": {
    "bond_id": {
      "type": "string",
      "description": "Bond identifier"
    },
    "companion_id": {
      "type": "string",
      "description": "AI companion"
    },
    "user_id": {
      "type": "string",
      "description": "User in relationship"
    },
    "bond_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Emotional connection strength"
    },
    "interaction_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "interaction_type": {
            "type": "string"
          },
          "emotional_resonance": {
            "type": "number"
          },
          "user_sentiment": {
            "type": "string"
          }
        }
      }
    },
    "learned_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preference_category": {
            "type": "string"
          },
          "preference_value": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "conversational_style": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string"
        },
        "formality": {
          "type": "number"
        },
        "humor_frequency": {
          "type": "number"
        },
        "vocabulary_complexity": {
          "type": "string"
        },
        "emoji_usage": {
          "type": "number"
        }
      }
    },
    "emotional_support_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger_emotion": {
            "type": "string"
          },
          "support_strategy": {
            "type": "string"
          },
          "effectiveness_score": {
            "type": "number"
          }
        }
      }
    },
    "trust_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "shared_experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "experience_type": {
            "type": "string"
          },
          "emotional_impact": {
            "type": "number"
          },
          "memory_significance": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "bond_id",
    "companion_id",
    "user_id"
  ]
}