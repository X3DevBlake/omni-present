{
  "name": "AgentDeployment",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Deployed agent"
    },
    "deployment_target": {
      "type": "string",
      "description": "Simulation or real-world task ID"
    },
    "deployment_type": {
      "type": "string",
      "enum": [
        "simulation",
        "real_world",
        "hybrid"
      ],
      "description": "Deployment type"
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "success_rate": {
          "type": "number"
        },
        "response_time": {
          "type": "number"
        },
        "error_rate": {
          "type": "number"
        }
      }
    },
    "retraining_triggered": {
      "type": "boolean",
      "default": false
    },
    "auto_monitoring": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "agent_id",
    "deployment_target",
    "deployment_type"
  ]
}