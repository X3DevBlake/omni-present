{
  "name": "MarketAsset",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Stock/asset ticker symbol"
    },
    "name": {
      "type": "string",
      "description": "Full asset name"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "stock",
        "etf",
        "commodity",
        "forex",
        "bond"
      ],
      "description": "Type of financial asset"
    },
    "exchange": {
      "type": "string",
      "description": "Exchange listing (NYSE, NASDAQ, etc)"
    },
    "current_price": {
      "type": "number",
      "description": "Current price in USD"
    },
    "price_change_24h": {
      "type": "number",
      "description": "24h price change percentage"
    },
    "price_change_7d": {
      "type": "number",
      "description": "7d price change percentage"
    },
    "market_cap": {
      "type": "number",
      "description": "Market capitalization"
    },
    "volume_24h": {
      "type": "number",
      "description": "24h trading volume"
    },
    "dividend_yield": {
      "type": "number",
      "description": "Annual dividend yield percentage"
    },
    "pe_ratio": {
      "type": "number",
      "description": "Price-to-earnings ratio"
    },
    "sector": {
      "type": "string",
      "description": "Industry sector"
    },
    "sentiment_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "Market sentiment (-1 to 1)"
    },
    "news_count": {
      "type": "integer",
      "default": 0,
      "description": "Recent news articles count"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last data update"
    }
  },
  "required": [
    "symbol",
    "name",
    "asset_type",
    "current_price"
  ]
}