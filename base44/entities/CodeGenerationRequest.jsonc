{
  "name": "CodeGenerationRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique code generation request identifier"
    },
    "developer_id": {
      "type": "string",
      "description": "Developer requesting code"
    },
    "natural_language_request": {
      "type": "string",
      "description": "What the developer asked for in plain language"
    },
    "target_language": {
      "type": "string",
      "enum": [
        "javascript",
        "typescript",
        "python",
        "jsx",
        "json"
      ],
      "description": "Programming language for generated code"
    },
    "code_context": {
      "type": "object",
      "properties": {
        "existing_code": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "cursor_position": {
          "type": "integer"
        },
        "related_entities": {
          "type": "array"
        }
      }
    },
    "generation_type": {
      "type": "string",
      "enum": [
        "function",
        "component",
        "entity_schema",
        "integration",
        "spatial_controller",
        "ai_agent_behavior"
      ],
      "description": "Type of code to generate"
    },
    "generated_code": {
      "type": "string",
      "description": "AI-generated code"
    },
    "explanation": {
      "type": "string",
      "description": "How the code works"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required imports/packages"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "user_accepted": {
      "type": "boolean",
      "default": false
    },
    "refinement_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "request_id",
    "developer_id",
    "natural_language_request",
    "target_language"
  ]
}