{
  "name": "OmniCardExtended",
  "type": "object",
  "properties": {
    "card_number": {
      "type": "string",
      "description": "Masked card number"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "virtual",
        "physical",
        "premium"
      ],
      "default": "virtual"
    },
    "card_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "frozen",
        "expired"
      ],
      "default": "active"
    },
    "spending_limit_daily": {
      "type": "number",
      "default": 1000
    },
    "spending_limit_monthly": {
      "type": "number",
      "default": 10000
    },
    "current_month_spending": {
      "type": "number",
      "default": 0
    },
    "card_design": {
      "type": "object",
      "properties": {
        "background_color": {
          "type": "string",
          "default": "#1e293b"
        },
        "accent_color": {
          "type": "string",
          "default": "#6366f1"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "gradient",
            "geometric",
            "waves",
            "neural"
          ],
          "default": "gradient"
        },
        "material": {
          "type": "string",
          "enum": [
            "matte",
            "glossy",
            "metallic",
            "holographic"
          ],
          "default": "metallic"
        }
      }
    },
    "transaction_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "merchant": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending",
              "declined"
            ]
          }
        }
      }
    },
    "security_features": {
      "type": "object",
      "properties": {
        "cvv": {
          "type": "string"
        },
        "pin_set": {
          "type": "boolean",
          "default": false
        },
        "biometric_enabled": {
          "type": "boolean",
          "default": false
        },
        "contactless_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "rewards_points": {
      "type": "number",
      "default": 0
    },
    "cashback_percentage": {
      "type": "number",
      "default": 1.5
    }
  },
  "required": [
    "card_type"
  ]
}