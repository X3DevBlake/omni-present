{
  "name": "AIBudgetForecast",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "forecast_month": {
      "type": "string",
      "format": "date",
      "description": "Month for forecast"
    },
    "predicted_income": {
      "type": "number",
      "description": "Predicted monthly income"
    },
    "predicted_spending": {
      "type": "number",
      "description": "Predicted total spending"
    },
    "spending_by_category": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Spending breakdown by category"
    },
    "savings_potential": {
      "type": "number",
      "description": "Estimated savings opportunity"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Forecast confidence percentage"
    },
    "anomalies_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "change_percent": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Unusual spending patterns"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Budget optimization recommendations"
    }
  },
  "required": [
    "user_email",
    "forecast_month"
  ]
}