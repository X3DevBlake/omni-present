{
  "name": "BehaviorTemplateVersion",
  "type": "object",
  "properties": {
    "version_id": {
      "type": "string",
      "description": "Version identifier"
    },
    "template_id": {
      "type": "string",
      "description": "Parent template"
    },
    "version_number": {
      "type": "string",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "forked_from": {
      "type": "string",
      "description": "Original template if forked"
    },
    "changes": {
      "type": "object",
      "properties": {
        "modified_traits": {
          "type": "array"
        },
        "added_guidelines": {
          "type": "array"
        },
        "removed_guidelines": {
          "type": "array"
        },
        "communication_updates": {
          "type": "object"
        }
      }
    },
    "performance_comparison": {
      "type": "object",
      "properties": {
        "vs_previous_version": {
          "type": "number"
        },
        "user_satisfaction_delta": {
          "type": "number"
        },
        "efficiency_improvement": {
          "type": "number"
        }
      }
    },
    "ai_diff_summary": {
      "type": "string",
      "description": "AI-generated change summary"
    },
    "snapshot_data": {
      "type": "object",
      "description": "Full template snapshot at this version"
    }
  },
  "required": [
    "version_id",
    "template_id",
    "version_number"
  ]
}