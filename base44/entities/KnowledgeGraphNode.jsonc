{
  "name": "KnowledgeGraphNode",
  "type": "object",
  "properties": {
    "node_type": {
      "type": "string",
      "enum": [
        "concept",
        "entity",
        "document",
        "activity",
        "skill",
        "memory"
      ],
      "description": "Type of knowledge node"
    },
    "label": {
      "type": "string",
      "description": "Node label/name"
    },
    "content": {
      "type": "string",
      "description": "Node content or description"
    },
    "embeddings": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vector embeddings for semantic search"
    },
    "connected_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of connected nodes"
    },
    "relationship_types": {
      "type": "object",
      "description": "Types of relationships to other nodes"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent that created or owns this node"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.8,
      "description": "Confidence in this knowledge"
    },
    "access_count": {
      "type": "integer",
      "default": 0,
      "description": "Times this node was accessed"
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Current relevance score"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    }
  },
  "required": [
    "node_type",
    "label",
    "content"
  ]
}