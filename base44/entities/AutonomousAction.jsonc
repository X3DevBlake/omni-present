{
  "name": "AutonomousAction",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Agent that initiated the action"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "proactive_assistance",
        "environmental_optimization",
        "predictive_preparation",
        "preventive_action",
        "contextual_suggestion"
      ],
      "description": "Type of autonomous action"
    },
    "trigger_analysis": {
      "type": "object",
      "properties": {
        "detected_pattern": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "environmental_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learned_behavior_match": {
          "type": "boolean"
        }
      }
    },
    "proposed_action": {
      "type": "string",
      "description": "What the agent proposed to do"
    },
    "execution_plan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string"
              },
              "device_id": {
                "type": "string"
              },
              "estimated_duration_seconds": {
                "type": "number"
              }
            }
          }
        },
        "required_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "auto_approved",
        "rejected"
      ],
      "default": "pending"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "user_satisfaction": {
          "type": "number"
        },
        "impact_assessment": {
          "type": "string"
        },
        "lessons_learned": {
          "type": "string"
        }
      }
    },
    "devices_affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "agent_id",
    "action_type",
    "proposed_action"
  ]
}