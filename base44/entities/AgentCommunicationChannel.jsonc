{
  "name": "AgentCommunicationChannel",
  "type": "object",
  "properties": {
    "channel_name": {
      "type": "string",
      "description": "Name of the communication channel"
    },
    "channel_type": {
      "type": "string",
      "enum": [
        "workflow",
        "simulation",
        "collaboration",
        "marketplace"
      ],
      "description": "Type of channel"
    },
    "participant_agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Agents in this channel"
    },
    "workflow_id": {
      "type": "string",
      "description": "Associated workflow ID"
    },
    "simulation_id": {
      "type": "string",
      "description": "Associated simulation ID"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether channel is active"
    },
    "message_count": {
      "type": "integer",
      "default": 0,
      "description": "Total messages in channel"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "Last message timestamp"
    },
    "sentiment_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "default": 0,
      "description": "Overall channel sentiment"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated channel summary"
    }
  },
  "required": [
    "channel_name",
    "channel_type",
    "participant_agent_ids"
  ]
}