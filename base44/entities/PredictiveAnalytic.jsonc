{
  "name": "PredictiveAnalytic",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "prediction_type": {
      "type": "string",
      "enum": [
        "system_issue",
        "user_need",
        "agent_action",
        "resource_bottleneck"
      ],
      "description": "Type of prediction"
    },
    "prediction": {
      "type": "string",
      "description": "Predicted outcome"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence percentage"
    },
    "data_analyzed": {
      "type": "object",
      "description": "Data used for prediction"
    },
    "suggested_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended actions"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "description": "Generated by AI"
    }
  },
  "required": [
    "user_email",
    "prediction_type",
    "prediction"
  ]
}