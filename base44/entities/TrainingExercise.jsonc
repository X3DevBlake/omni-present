{
  "name": "TrainingExercise",
  "type": "object",
  "properties": {
    "exercise_name": {
      "type": "string"
    },
    "skill_target": {
      "type": "string",
      "description": "Skill being trained"
    },
    "difficulty_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "exercise_type": {
      "type": "string",
      "enum": [
        "simulation",
        "problem_solving",
        "collaboration",
        "decision_making",
        "creative"
      ],
      "description": "Type of exercise"
    },
    "scenario_config": {
      "type": "object",
      "description": "Exercise scenario parameters"
    },
    "success_criteria": {
      "type": "object",
      "description": "What constitutes success"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true
    },
    "completion_count": {
      "type": "integer",
      "default": 0
    },
    "avg_success_rate": {
      "type": "number"
    },
    "estimated_duration_minutes": {
      "type": "number"
    }
  },
  "required": [
    "exercise_name",
    "skill_target",
    "difficulty_level"
  ]
}