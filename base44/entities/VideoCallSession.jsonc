{
  "name": "VideoCallSession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent ID"
    },
    "session_id": {
      "type": "string",
      "description": "Video session ID"
    },
    "ai_model": {
      "type": "string",
      "enum": [
        "gpt4",
        "gemini",
        "claude",
        "custom"
      ],
      "description": "AI model for responses"
    },
    "video_stream_url": {
      "type": "string",
      "description": "Video stream URL"
    },
    "audio_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Audio on/off"
    },
    "video_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Video on/off"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Conversation transcript"
    },
    "status": {
      "type": "string",
      "enum": [
        "connecting",
        "active",
        "paused",
        "ended"
      ],
      "default": "connecting",
      "description": "Session status"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "End time"
    }
  },
  "required": [
    "user_email",
    "agent_id",
    "session_id"
  ]
}