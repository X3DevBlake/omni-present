{
  "name": "Embodiment Health Monitor",
  "description": "Monitors physical embodiment health when state changes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PhysicallyEmbodiedAgent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "embodiment_health_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "body/neural-chip-controller",
            "args": {
              "operation": "health_check"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "body/neural-chip-controller"
  }
}